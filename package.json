{
  "name": "devtools",
  "version": "1.0.0",
  "description": "This is a sample plugin for SiYuan (https://b3log.org/siyuan)",
  "main": "./src/index.ts",
  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint . --fix --cache",
    "postinstall": "node scripts/build-vconsole.mjs --if-needed",
    "build:vconsole": "node scripts/build-vconsole.mjs",
    "update:vconsole": "git submodule update --init --remote -- vendor/vconsole && node scripts/build-vconsole.mjs",
    "dev": "node scripts/build-vconsole.mjs --if-needed && webpack --config webpack.config.js --mode development",
    "build": "node scripts/build-vconsole.mjs --if-needed && webpack --config webpack.config.js --mode production",
    "typecheck": "node scripts/build-vconsole.mjs --if-needed && tsc --noEmit",
    "push": "git push origin HEAD --tags"
  },
  "keywords": [],
  "author": "Jeffrey Chen",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "dprint": "^0.55.2",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "siyuan": "github:siyuan-note/petal#f0b4c518ac2862a6ea4e13e0a58339ee9eff3c00",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "zip-webpack-plugin": "^4.0.3"
  },
  "dependencies": {
    "vconsole": "file:vendor/vconsole"
  }
}
